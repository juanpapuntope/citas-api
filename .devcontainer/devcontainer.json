{
  "name": "citas-api - Java 21",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "none", "installMaven": "true" }
  },
  "customizations": {
    "vscode": { "extensions": ["vscjava.vscode-java-pack", "humao.rest-client"] }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "citas-api", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "mvn -B -q -DskipTests package",
  "postAttachCommand": "mvn -B spring-boot:run -Dspring-boot.run.profiles=demo"
}