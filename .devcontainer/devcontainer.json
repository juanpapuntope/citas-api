{
  "name": "citas-api - Java 21",
  "image": "mcr.microsoft.com/devcontainers/java:1-21-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "none", "installMaven": "true" }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "citas-api (Swagger)", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "mvn -B -q -DskipTests package",
  "postAttachCommand": "bash -c 'P=${DB_URL:+dev}; P=${P:-demo}; echo Perfil: $P; mvn -B spring-boot:run -Dspring-boot.run.profiles=$P'"
}